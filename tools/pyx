#!/usr/bin/env python3
"""pyx - symbol-level Python navigation (stdlib only).

  pyx outline PATH...        symbols per file: line range, signature, return type, docstring line
  pyx show FILE NAME...      full source of a symbol, e.g. Study.get_absolute_url (decorators included)
  pyx find NAME [PATH...]    definitions and references of NAME across files (default: cwd)
"""
import ast
import warnings
import os
import subprocess
import sys

warnings.simplefilter("ignore")
FUNCS = (ast.FunctionDef, ast.AsyncFunctionDef)
DEFS = FUNCS + (ast.ClassDef,)


def py_files(paths):
    for p in paths:
        if os.path.isfile(p):
            yield p
            continue
        try:
            out = subprocess.run(
                ["git", "-C", p, "ls-files", "-co", "--exclude-standard", "--", "*.py"],
                capture_output=True, text=True, check=True).stdout.split("\n")
            for f in sorted(filter(None, out)):
                full = os.path.join(p, f)
                if os.path.isfile(full):
                    yield os.path.normpath(full)
        except (subprocess.CalledProcessError, FileNotFoundError):
            skip = {".git", ".venv", "venv", "node_modules", "__pycache__"}
            for root, dirs, files in os.walk(p):
                dirs[:] = sorted(d for d in dirs if d not in skip)
                for f in sorted(files):
                    if f.endswith(".py"):
                        yield os.path.normpath(os.path.join(root, f))


def parse(path):
    try:
        with open(path, "rb") as fh:
            src = fh.read()
        return ast.parse(src, filename=path), src.decode("utf-8", "replace").splitlines()
    except (SyntaxError, ValueError, OSError) as e:
        print(f"{path}: skipped ({type(e).__name__})", file=sys.stderr)
        return None, []


def first_line(node):
    doc = ast.get_docstring(node)
    return doc.strip().splitlines()[0] if doc else ""


def start(node):
    return min([node.lineno] + [d.lineno for d in node.decorator_list])


def signature(node):
    if isinstance(node, ast.ClassDef):
        bases = ", ".join(ast.unparse(b) for b in node.bases + node.keywords)
        return f"class {node.name}" + (f"({bases})" if bases else "")
    a = node.args
    if a.args and a.args[0].arg in ("self", "cls"):
        a = ast.arguments(**{**{k: getattr(a, k) for k in a._fields},
                             "args": a.args[1:],
                             "posonlyargs": a.posonlyargs})
    args = ast.unparse(a)
    ret = f" -> {ast.unparse(node.returns)}" if node.returns else ""
    kw = "async def" if isinstance(node, ast.AsyncFunctionDef) else "def"
    return f"{kw} {node.name}({args}){ret}"


def decorators(node):
    return " ".join("@" + ast.unparse(d).split("(")[0] for d in node.decorator_list)


def children(node):
    """Defs nested directly in node, looking through if/try/with blocks."""
    for c in ast.iter_child_nodes(node):
        if isinstance(c, DEFS):
            yield c
        elif isinstance(c, (ast.If, ast.Try, ast.With, ast.For, ast.While)):
            yield from children(c)


def cmd_outline(paths):
    for path in py_files(paths or ["."]):
        tree, lines = parse(path)
        if tree is None:
            continue
        print(f"{path} ({len(lines)} lines)")
        mod = first_line(tree)
        if mod:
            print(f"  \"\"\" {mod}")

        def walk(node, depth):
            for c in children(node):
                dec = decorators(c)
                doc = first_line(c)
                print(f"{'  ' * (depth + 1)}{start(c)}-{c.end_lineno}  "
                      f"{(dec + ' ') if dec else ''}{signature(c)}"
                      f"{('  # ' + doc) if doc else ''}")
                if isinstance(c, ast.ClassDef):
                    walk(c, depth + 1)

        walk(tree, 0)


def lookup(tree, dotted):
    node = tree
    for part in dotted.split("."):
        found = [c for c in children(node) if c.name == part]
        if not found:
            return None
        node = found[-1]
    return node


def cmd_show(args):
    if len(args) < 2:
        sys.exit("usage: pyx show FILE NAME...")
    path, names = args[0], args[1:]
    tree, lines = parse(path)
    if tree is None:
        sys.exit(1)
    for name in names:
        node = lookup(tree, name)
        if node is None:
            print(f"{path}: no symbol {name!r} (try: pyx outline {path})", file=sys.stderr)
            continue
        s, e = start(node), node.end_lineno
        print(f"# {path}:{s}-{e} {name}")
        for i in range(s, e + 1):
            print(f"{i:>5}  {lines[i - 1]}")


def cmd_find(args):
    if not args:
        sys.exit("usage: pyx find NAME [PATH...]")
    name, paths = args[0], args[1:] or ["."]
    defs, refs = [], []
    for path in py_files(paths):
        tree, lines = parse(path)
        if tree is None:
            continue

        def visit(node, scope):
            for c in ast.iter_child_nodes(node):
                if isinstance(c, DEFS):
                    here = scope + [c.name]
                    if c.name == name:
                        defs.append(f"{path}:{start(c)}-{c.end_lineno}  {signature(c)}")
                    visit(c, here)
                    continue
                hit = (isinstance(c, ast.Name) and c.id == name) or \
                      (isinstance(c, ast.Attribute) and c.attr == name) or \
                      (isinstance(c, ast.alias) and name in (c.name.split(".")[-1], c.asname)) or \
                      (isinstance(c, ast.keyword) and c.arg == name)
                if hit and hasattr(c, "lineno"):
                    where = ".".join(scope) or "<module>"
                    refs.append(f"{path}:{c.lineno}  [{where}]  {lines[c.lineno - 1].strip()[:110]}")
                visit(c, scope)

        visit(tree, [])
    print(f"== definitions of {name} ({len(defs)})")
    print("\n".join(defs))
    seen = list(dict.fromkeys(refs))
    print(f"== references ({len(seen)})")
    print("\n".join(seen))


def main():
    cmds = {"outline": cmd_outline, "show": cmd_show, "find": cmd_find}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        sys.exit(__doc__)
    cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
