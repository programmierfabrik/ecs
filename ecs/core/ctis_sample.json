    "principalInclusionCriteria": [
     {
      "id": "2",
      "description": "Unterzeichnete und datierte Einverständniserklärung vor jeder studienbezogenen Maßnahme."
     },
     {
      "id": "5",
      "description": "Männliche oder weibliche Teilnehmer ab 18 Jahren zum Zeitpunkt der Unterzeichnung der Einverständniserklärung."
     },
     {
      "id": "6",
      "description": "ECOG-Leistungsstatus 0, 1 oder 3."
     },
     {
      "id": "7",
      "description": "Teilnehmer mit histologisch oder zytologisch bestätigtem Adenokarzinom der Lunge."
     },
     {
      "id": "8",
      "description": "Teilnehmer mit bekanntem ALK-Expression durch IHC"
     },
     {
      "id": "9",
      "description": "Teilnehmer müssen ein positives ALK-PET-Bildungsergebnis vorweisen."
     },
     {
      "id": "10",
      "description": "Frauen im gebärfähigen Alter (WOCBP) müssen einen negativen Urin-/Serum-Schwangerschaftstest haben. WOCBP, die sexuell aktiv sind, müssen zustimmen, während der Studiendauer und mindestens 90 Tage nach der Studienintervention wirksame Verhütungsmethoden anzuwenden. Erlaubt sind anerkannte und wirksame nicht-hormonelle Formen der Verhütung sowie sexuelle Enthaltsamkeit oder sterilisierte Partner (>6 Monate zuvor). Sterilisierung muss durch zwei negative Samenanalysen bestätigt werden."
     },
     {
      "id": "11",
      "description": "Männliche Teilnehmer müssen zustimmen, während der Studiendauer Kondome zu verwenden und 90 Tage nach Verlassen der Studie, falls ihre Partnerin gebärfähig ist und keine Verhütungsmittel anwendet, oder eine dokumentierte permanente Sterilisation durch Vasektomie haben. Sie dürfen während der Studiendauer und 30 Tage nach Beendigung der Studie kein Sperma spenden."
     }
    ],
    "principalExclusionCriteria": [
     {
      "id": "3",
      "description": "Andere bekannte gleichzeitig bestehende bösartige Krankheiten mit klinischer Relevanz, außer Teilnehmern mit einer vollständigen Remissionsgeschichte von malignen Tumoren >5 Jahre, ohne Hinweise auf ein Wiederauftreten <10 Jahre"
     },
     {
      "id": "12",
      "description": "Jede Erkrankung, die eine längere Position mit gehobenen Armen für Bildgebungszwecke ausschließt"
     },
     {
      "id": "20",
      "description": "Vorherige Verabreichung eines Radiopharmakons innerhalb eines Zeitraums, der 15 Halbwertszeiten des verwendeten Radionuklids entspricht"
     },
     {
      "id": "22",
      "description": "Gleichzeitige Behandlung mit einem CCK2R-basierten Therapiemittel"
     },
     {
      "id": "24",
      "description": "Klinisch relevante Erkrankung oder wesentliche körperliche Verletzung innerhalb von 4 Wochen vor Gabe des Untersuchungsprodukts"
     },
     {
      "id": "16",
      "description": "Personen mit jeglicher Abhängigkeit vom Studienleiter oder Beschäftigung durch den Sponsor oder Studienleiter"
     },
     {
      "id": "18",
      "description": "Personen, die rechtlich oder offiziell angeordnet in einer Einrichtung untergebracht sind"
     },
     {
      "id": "10",
      "description": "Organtransplantation, die eine immunsuppressive Therapie erfordert"
     },
     {
      "id": "7",
      "description": "Schwerwiegende Einschränkung der Organfunktion, die die Ausscheidung und den Metabolismus des Bildgebungswirkstoffs beeinträchtigen könnte. Insbesondere werden Teilnehmer ausgeschlossen, wenn sie folgende Kriterien erfüllen: • Hämatologisch (Thrombozyten <80K/mcL; ANC <1.5 K/mcL) • Hepatisch (Bilirubin >2.5 x ULN; AST/ALT >3.0 x ULN) • Renal (Kreatinin > 2.5 x ULN)"
     },
     {
      "id": "9",
      "description": "Platzangst, die die SPECT/CT-Bildgebung beeinträchtigt"
     },
     {
      "id": "11",
      "description": "Deutlich abnormaler EKG-Befund (Hinweise auf Ischämie, hochgradige ventrikuläre Arrhythmie, hochgradige supraventrikuläre Arrhythmie)"
     },
     {
      "id": "8",
      "description": "Schwangerschaft, Stillzeit."
     },
     {
      "id": "5",
      "description": "Teilnehmer mit gleichzeitigen Erkrankungen oder schweren Infektionskrankheiten, die den Studienabschluss behindern könnten."
     },
     {
      "id": "6",
      "description": "Teilnehmer mit Blasenausflussobstruktion oder nicht beherrschbarer Harninkontinenz"
     },
     {
      "id": "10",
      "description": "Bekannte Überempfindlichkeit gegen Barium-133, XYG456 oder gegen einen der Hilfsstoffe des Prüfpräparats"
     }
    ],
    "protocolCode": "XYG002BT204",
